# Movie Theater FE environment variables

# Leave empty in local development to use Vite proxy /api -> localhost:8080
VITE_API_URL=

# WebSocket endpoint (optional). Defaults to {VITE_API_URL}/ws or same-origin /ws
VITE_WS_URL=

# Set true to use SockJS fallback transport (XHR info polling). Default: native WebSocket.
VITE_WS_USE_SOCKJS=false

# Optional app name
VITE_APP_NAME=NASA FILM

# Google Sign-In Web Client ID
VITE_GOOGLE_CLIENT_ID=
