# Movie Theater FE environment variables

# Leave empty in local development to use Vite proxy /api -> localhost:8080
VITE_API_URL=

# WebSocket endpoint (optional). Defaults to {origin}/stomp (native) or {origin}/ws (SockJS).
VITE_WS_URL=

# Set true to use SockJS at /ws. Default: native WebSocket at /stomp.
VITE_WS_USE_SOCKJS=false

# Optional app name
VITE_APP_NAME=NASA FILM

# Google Sign-In Web Client ID
VITE_GOOGLE_CLIENT_ID=
