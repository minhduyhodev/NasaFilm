# Movie Theater FE environment variables

# Leave empty in local development to use Vite proxy /api -> localhost:8080
VITE_API_URL=

# Optional app name
VITE_APP_NAME=NASA FILM

# Google Sign-In Web Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Stripe keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Security API Key (Must match API_KEY in backend)
VITE_API_KEY=your_custom_secret_api_key_here
