# Movie Theater FE — Environment Variables
# Copy file này thành .env và điều chỉnh cho môi trường local

# DEV: Để trống → FE dùng Vite proxy (/api/* → localhost:8080)
# Vite proxy config trong vite.config.ts đã forward /api/* → http://localhost:8080
# KHÔNG cần đặt http://localhost:8080 trực tiếp (gây CORS error)
VITE_API_URL=

# PRODUCTION: Bỏ comment dòng dưới và điền URL thật
# VITE_API_URL=https://your-production-api.com

# Tên app (tuỳ chọn)
VITE_APP_NAME=THDPV Cinema
