# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_theater
DB_USERNAME=postgres
DB_PASSWORD=replace_with_strong_password

# JWT (use a long random secret in every non-local environment)
APP_JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
APP_JWT_ACCESS_EXPIRATION=900000
APP_JWT_REFRESH_EXPIRATION=604800000

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=your_google_client_id_here

# Seed accounts (change before any shared deploy)
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=replace_me
APP_SEED_ADMIN_FULL_NAME=Admin User

APP_SEED_STAFF_EMAIL=staff@example.com
APP_SEED_STAFF_PASSWORD=replace_me
APP_SEED_STAFF_FULL_NAME=Staff User

APP_SEED_CUSTOMER_EMAIL=customer@example.com
APP_SEED_CUSTOMER_PASSWORD=replace_me
APP_SEED_CUSTOMER_FULL_NAME=Customer User

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

# Groq (optional) - for AI Assistant
APP_GROQ_API_KEY=
APP_GROQ_MODEL=llama-3.1-8b-instant
APP_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Frontend Config
APP_FRONTEND_URL=http://localhost:5173

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Security API Key for frontend requests
API_KEY=your_custom_secret_api_key_here

# Stripe Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Optional
APP_SWAGGER_ENABLED=true
SPRING_PROFILES_ACTIVE=dev
