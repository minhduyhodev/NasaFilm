DB_HOST=localhost
DB_PORT=5432
DB_NAME=movie_theater
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

APP_JWT_SECRET=replace_with_at_least_32_random_bytes
APP_JWT_ACCESS_EXPIRATION=900000
APP_JWT_REFRESH_EXPIRATION=604800000
GOOGLE_WEB_CLIENT_ID=437474053343-5ijcjhd1vdctgp7gspfo1tsip5jc596d.apps.googleusercontent.com

APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=ChangeMe123!
APP_SEED_ADMIN_FULL_NAME=Ho Minh Duy

APP_SEED_STAFF_EMAIL=staff@example.com
APP_SEED_STAFF_PASSWORD=ChangeMe123!
APP_SEED_STAFF_FULL_NAME=Staff User

APP_SEED_CUSTOMER_EMAIL=customer@example.com
APP_SEED_CUSTOMER_PASSWORD=ChangeMe123!
APP_SEED_CUSTOMER_FULL_NAME=Customer User


MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

# Groq (optional) - for AI Assistant
APP_GROQ_API_KEY=
APP_GROQ_MODEL=llama-3.1-8b-instant
APP_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Optional faster model for support image checks (falls back to APP_GROQ_MODEL)
APP_SUPPORT_VISION_MODEL=

# TMDB (optional) — actor avatar enrichment via person search API
APP_TMDB_API_KEY=
APP_ACTOR_ENRICH_AVATARS_ON_STARTUP=true

# Frontend Config
APP_FRONTEND_URL=http://localhost:5173

# Cloudinary Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# none = AI vision moderation (default). aws_rek = paid Cloudinary add-on (optional).
CLOUDINARY_SUPPORT_MODERATION=none


VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
API_KEY=your_custom_secret_api_key

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# VietQR (optional — defaults in application.properties if unset)
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NO=6102005112233
VIETQR_ACCOUNT_NAME=HO MINH DUY
VIETQR_BANK_NAME=MB Bank
VIETQR_TEMPLATE=compact2
VIETQR_BANK_LOGO=https://img.vietqr.io/img/MB.png
VIETQR_WEBHOOK_TOKEN=

# AWS S3 media upload (optional)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=java-06
AWS_S3_PRESIGN_TTL=900
AWS_S3_MULTIPART_PART_SIZE=16777216

# Logging
LOG_LEVEL_ROOT=INFO
LOG_DIR=logs

# VOD stream cookie
# Local HTTP: false + Lax. HTTPS production: true.
# If frontend/API are cross-site: true + None.
VOD_STREAM_COOKIE_SECURE=false
VOD_STREAM_COOKIE_SAME_SITE=Lax
VOD_MAX_STREAM_CHUNK_BYTES=8388608
