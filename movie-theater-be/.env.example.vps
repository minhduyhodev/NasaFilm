# =========================================================================
# VPS ENVIRONMENT CONFIGURATION TEMPLATE (PRODUCTION)
# Rename this file to '.env' on your Ubuntu VPS.
# =========================================================================

# Spring Boot Environment
SPRING_PROFILES_ACTIVE=prod
APP_FRONTEND_URL=https://nasafilm-fe.vercel.app

# Database Supabase / PostgreSQL Connection Configuration
# Note: Use sslmode=require for secure connection to Supabase
DB_HOST=<YOUR_SUPABASE_DB_HOST>
DB_PORT=5432
DB_NAME=<YOUR_DB_NAME>
DB_USERNAME=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# Redis Config (matches the service name 'redis' in docker-compose.yml)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Config
APP_JWT_SECRET=<YOUR_SUPER_SECRET_KEY>
APP_JWT_ACCESS_EXPIRATION=900000
APP_JWT_REFRESH_EXPIRATION=604800000

# Other Integrations (Cloudinary, AWS S3, Stripe, Groq, VietQR...)
# Copy and populate from your local .env as needed.
